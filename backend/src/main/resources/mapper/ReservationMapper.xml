<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.mapper.ReservationMapper">

    <resultMap id="ReservationResultMap" type="com.hotel.entity.Reservation">
        <id property="id" column="id"/>
        <result property="reservationNo" column="reservation_no"/>
        <result property="customerId" column="customer_id"/>
        <result property="roomTypeId" column="room_type_id"/>
        <result property="roomId" column="room_id"/>
        <result property="checkInDate" column="check_in_date"/>
        <result property="checkOutDate" column="check_out_date"/>
        <result property="nights" column="nights"/>
        <result property="roomCount" column="room_count"/>
        <result property="guestCount" column="guest_count"/>
        <result property="totalPrice" column="total_price"/>
        <result property="deposit" column="deposit"/>
        <result property="status" column="status"/>
        <result property="source" column="source"/>
        <result property="remark" column="remark"/>
        <result property="cancelReason" column="cancel_reason"/>
        <result property="operatorId" column="operator_id"/>
        <result property="deleted" column="deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <association property="customer" javaType="com.hotel.entity.Customer">
            <id property="id" column="c_id"/>
            <result property="name" column="c_name"/>
            <result property="phone" column="c_phone"/>
            <result property="idCard" column="c_id_card"/>
        </association>
        <association property="roomType" javaType="com.hotel.entity.RoomType">
            <id property="id" column="rt_id"/>
            <result property="typeName" column="type_name"/>
            <result property="price" column="price"/>
        </association>
        <association property="room" javaType="com.hotel.entity.Room">
            <id property="id" column="r_id"/>
            <result property="roomNumber" column="room_number"/>
        </association>
    </resultMap>

    <select id="selectReservationPage" resultMap="ReservationResultMap">
        SELECT rv.*,
               c.id as c_id, c.name as c_name, c.phone as c_phone, c.id_card as c_id_card,
               rt.id as rt_id, rt.type_name, rt.price,
               r.id as r_id, r.room_number
        FROM reservation rv
        LEFT JOIN customer c ON rv.customer_id = c.id
        LEFT JOIN room_type rt ON rv.room_type_id = rt.id
        LEFT JOIN room r ON rv.room_id = r.id
        WHERE rv.deleted = 0
        <if test="reservationNo != null and reservationNo != ''">
            AND rv.reservation_no LIKE CONCAT('%', #{reservationNo}, '%')
        </if>
        <if test="customerName != null and customerName != ''">
            AND c.name LIKE CONCAT('%', #{customerName}, '%')
        </if>
        <if test="phone != null and phone != ''">
            AND c.phone LIKE CONCAT('%', #{phone}, '%')
        </if>
        <if test="status != null">
            AND rv.status = #{status}
        </if>
        <if test="startDate != null">
            AND rv.check_in_date >= #{startDate}
        </if>
        <if test="endDate != null">
            AND rv.check_in_date &lt;= #{endDate}
        </if>
        ORDER BY rv.create_time DESC
    </select>

    <select id="selectReservationById" resultMap="ReservationResultMap">
        SELECT rv.*,
               c.id as c_id, c.name as c_name, c.phone as c_phone, c.id_card as c_id_card,
               rt.id as rt_id, rt.type_name, rt.price,
               r.id as r_id, r.room_number
        FROM reservation rv
        LEFT JOIN customer c ON rv.customer_id = c.id
        LEFT JOIN room_type rt ON rv.room_type_id = rt.id
        LEFT JOIN room r ON rv.room_id = r.id
        WHERE rv.id = #{id} AND rv.deleted = 0
    </select>

</mapper>
