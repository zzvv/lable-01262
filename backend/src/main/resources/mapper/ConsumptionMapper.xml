<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.mapper.ConsumptionMapper">

    <resultMap id="ConsumptionResultMap" type="com.hotel.entity.Consumption">
        <id property="id" column="id"/>
        <result property="consumptionNo" column="consumption_no"/>
        <result property="checkInId" column="check_in_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="itemName" column="item_name"/>
        <result property="quantity" column="quantity"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="isBilled" column="is_billed"/>
        <result property="billId" column="bill_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="cancelOperatorId" column="cancel_operator_id"/>
        <result property="cancelTime" column="cancel_time"/>
        <result property="cancelRemark" column="cancel_remark"/>
        <result property="remark" column="remark"/>
        <result property="deleted" column="deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectConsumptionPage" resultMap="ConsumptionResultMap">
        SELECT c.*
        FROM consumption c
        LEFT JOIN check_in ci ON c.check_in_id = ci.id
        LEFT JOIN room r ON ci.room_id = r.id
        WHERE c.deleted = 0
        <if test="checkInId != null">
            AND c.check_in_id = #{checkInId}
        </if>
        <if test="roomNumber != null and roomNumber != ''">
            AND r.room_number LIKE CONCAT('%', #{roomNumber}, '%')
        </if>
        <if test="status != null">
            AND c.status = #{status}
        </if>
        <if test="isBilled != null">
            AND c.is_billed = #{isBilled}
        </if>
        <if test="startDate != null">
            AND c.create_time >= #{startDate}
        </if>
        <if test="endDate != null">
            AND c.create_time <= #{endDate}
        </if>
        ORDER BY c.create_time DESC
    </select>

</mapper>
